# Sandbox service
MLE_SANDBOX_BASE_URL=http://127.0.0.1:6580
MLE_SANDBOX_API_KEY=

# Optional Skill overrides (the repository defaults to ./skills)
MLE_TASK_SKILLS_DIR=
MLE_ERROR_SKILL_FILE=

# External data
MLE_SUBMIT_DATA_ROOT=
MLE_LEADERBOARD_DIR=

# Optional model-download endpoint propagated to sandbox jobs
MLE_HF_ENDPOINT=

# Optional defaults used by scripts/run_single_task.sh
MLE_MODEL=gpt-5.4
MLE_REASONING_LEVEL=medium
