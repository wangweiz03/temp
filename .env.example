# Sandbox service
MLE_SANDBOX_BASE_URL=http://127.0.0.1:6580
MLE_SANDBOX_API_KEY=

# Optional Skill overrides (the repository defaults to ./skills)
MLE_TASK_SKILLS_DIR=
MLE_ERROR_SKILL_FILE=

# External data
MLE_SUBMIT_DATA_ROOT=
MLE_LEADERBOARD_DIR=

# Optional model-download endpoint propagated to sandbox jobs
MLE_HF_ENDPOINT=

# Harness selection and task source (export these variables when using shell scripts)
MLE_DATA_FILE=/hpc_data/ktian/superml/dataset/automl_parquet_valid_low_current_fixed/eval.parquet
MLE_HARNESS_MODEL=codex
MLE_MODEL=
MLE_REASONING_LEVEL=medium
MLE_HARNESS_TIMEOUT_SECONDS=3600

# Claude Code API-compatible endpoint (only needed for --harness-model claude-code)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
